---
// The home page is the study's argument: the two-minute summary laid out one step per row, each
// with its main number, one chart from the chapter that holds the evidence, and the links to it.
// The words come from the CMS (the cover and the two-minute summary), so editors change them there.
import Base from '../layouts/Base.astro';
import { loadPage } from '../lib/content';
import { parseArgument, coverPartAnswers, type Step } from '../lib/front';
import { audienceLabel, t } from '../lib/i18n';
import { canReadPage } from '../lib/access';
import { KEY_NUMBERS, renderInline, renderKeyNumber, renderMarkdown } from '../lib/markdown';
import { renderChartFigure } from '../lib/charts';
import { evidenceNote } from '../lib/html';
import {
  AUDIENCES,
  PAGES,
  PAGE_BY_ID,
  PART_LIST,
  ROLE,
  SITE,
  chapterNumber,
  href,
  localize,
  partPath,
} from '../lib/site';

const lang = Astro.locals.lang ?? 'en';
const s = t(lang);
const vi = lang === 'vi';
const editor = Astro.locals.editor;

type Entry = Awaited<ReturnType<typeof loadPage>>['entry'];
let cover: Entry = null;
let twoMinute: Entry = null;
try {
  [cover, twoMinute] = await Promise.all([
    loadPage(ROLE.cover).then((r) => r.entry),
    loadPage(ROLE.twoMinute).then((r) => r.entry),
  ]);
} catch (error) {
  console.error(error);
}
const coverBody = cover?.data.body ?? '';
const argument = parseArgument(twoMinute?.data.body ?? '');
const partAnswers = coverPartAnswers(coverBody);

// One chart per step, from the first chapter the step cites that has a lead chart, never twice.
const LEAD_CHART: Record<string, string> = {
  'ch01-why-vietnam': 'chart-feed-import-dependence',
  'ch26-plays': 'chart-plays-scoring',
  'ch18-demand-sizing': 'chart-demand-routes',
  'ch16-business-buyers': 'chart-plant-protein-imports',
  'ch27-policy-options': 'chart-policy-effort-impact',
};
const usedCharts = new Set<string>();
const opts = { lang, pageId: ROLE.twoMinute, editor, citeTarget: 'sources' as const };
const cite = (ids: string[]) =>
  `<sup class="cite">${ids
    .map(
      (id, i) =>
        `<a href="${href(ROLE.sources, lang, id)}" data-src="${id}" title="${id}">${i + 1}</a>`,
    )
    .join('<span class="cite-sep">,</span>')}</sup>`;
const steps = argument.steps.map((step: Step, i) => {
  const chartPage = step.pages.find((p) => LEAD_CHART[p] && !usedCharts.has(LEAD_CHART[p]));
  const chart = chartPage ? LEAD_CHART[chartPage] : undefined;
  if (chart) usedCharts.add(chart);
  // A step may open with only its chapter links, "([[ch27-policy-options]], ...):"; the links are
  // listed under the step, so the bare parenthesis is dropped.
  const text = step.body.replace(/^\((?:\[\[[a-z0-9-]+(?:#[a-z0-9-]+)?\]\](?:,\s*)?)+\):?\s*/, '');
  const body = renderMarkdown(text, opts);
  return {
    n: String(i + 1).padStart(2, '0'),
    lead: step.lead,
    html: body.html,
    tiles: step.kn.filter((k) => KEY_NUMBERS[k]).map((k) => renderKeyNumber(k, opts, 'hero')),
    chart: chart
      ? renderChartFigure(chart, lang, cite, { editor, staticOnly: true, compact: true })
      : '',
    pages: step.pages.filter((p) => PAGE_BY_ID.has(p) && canReadPage(p, editor)),
  };
});
const lede = argument.lede ? renderInline(argument.lede.body, opts) : '';
const coverDraft = /^> \*\*Draft for review\.\*\*\s*(.+)$/m.exec(coverBody)?.[1] ?? '';

// Briefs, one per audience; reading paths for every audience the manifest lists.
const briefs = PAGES.filter((p) => p.section === 'brief').sort((a, b) => a.order - b.order);
const paths = Object.fromEntries(
  AUDIENCES.map((a) => [
    a,
    (SITE.audience_paths[a] ?? []).filter((id) => PAGE_BY_ID.has(id) && canReadPage(id, editor)),
  ]),
);
const enSummary = PAGE_BY_ID.get(ROLE.summary)!;
const prologue = PAGE_BY_ID.get(ROLE.prologue)!;
const released = (() => {
  const [y, m] = (SITE.versions.find((v) => v.version === SITE.version)?.date ?? '')
    .split('-')
    .map(Number);
  if (!m) return '';
  return vi
    ? `tháng ${m}/${y}`
    : new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
        Date.UTC(y, m - 1),
      );
})();
const proofTiles = ['kn-sources-count', 'kn-solutions-screened']
  .filter((k) => KEY_NUMBERS[k])
  .map((k) => renderKeyNumber(k, opts));
const titleLines = vi
  ? { h1: 'Protein thay thế tại Việt Nam', sub: 'Nghiên cứu xác định phạm vi phía cung' }
  : {
      h1: /^# (.+)$/m.exec(coverBody)?.[1] ?? s.studyTitle,
      sub: /^## (.+)$/m.exec(coverBody)?.[1] ?? s.studySub,
    };
const contentLang = vi ? 'en' : undefined;
const legendScope = ['direct', 'adjacent', 'general'] as const;
---

<Base
  title={cover?.data.title ?? SITE.title}
  description={cover?.data.summary ?? SITE.title}
  content={cover ? { collection: 'pages', id: cover.id, slug: ROLE.cover } : undefined}
  current={ROLE.cover}
  pageClass="page-home"
  banner
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">
          {SITE.publisher} · {s.draft(SITE.version)}
          {released && `, ${released}`}
        </p>
        <h1 class="hero-title" lang={vi ? 'vi' : undefined}>
          {titleLines.h1}
        </h1>
        <p class="hero-sub" lang={vi ? 'vi' : undefined}>
          {titleLines.sub}
        </p>
        {!vi && cover?.data.subtitle && <p class="hero-q">{cover.data.subtitle}</p>}
        <div class="hero-cta">
          <a
            class="btn btn-primary"
            href={href(ROLE.summary, lang)}
            hreflang={vi ? enSummary.lang : undefined}
          >
            {s.homeReadSummary} <small>{s.minutes(enSummary.reading_time_min ?? 0)}</small>
          </a>
          <a class="btn" href={href(prologue.id, lang)} hreflang={vi ? prologue.lang : undefined}>
            {s.homeNewcomers}
          </a>
        </div>
      </div>
      <aside class="hero-note" aria-label={s.homeAbout}>
        {lede && <p class="lede" lang={contentLang} set:html={lede} />}
        {coverDraft && (
          <p class="draft-note" lang={contentLang}>
            <strong>{vi ? SITE.draft_notice.vi : 'Draft for review.'}</strong>{' '}
            {vi ? s.draftNotice : coverDraft}
          </p>
        )}
      </aside>
    </div>
  </section>

  <section class="sec" id="argument" aria-labelledby="arg-h">
    <div class="wrap">
      <header class="sec-head">
        <h2 id="arg-h">{s.homeArgument}</h2>
        <p>{s.homeArgumentIntro(steps.length)}</p>
      </header>
      <ol class="steps">
        {steps.map((st, i) => (
          <li class="step" id={`step-${i + 1}`}>
            <p class="step-num" aria-hidden="true">
              {st.n}
            </p>
            <div class="step-text" lang={contentLang}>
              <h3>{st.lead}</h3>
              <div class="step-body" set:html={st.html} />
              {st.pages.length > 0 && (
                <p class="step-links" lang={lang}>
                  <span>{s.homeEvidenceIn}</span>
                  {st.pages.map((id) => {
                    const p = PAGE_BY_ID.get(id)!;
                    const n = chapterNumber(id);
                    return (
                      <a href={href(id, lang)} lang={p.lang !== lang ? p.lang : undefined}>
                        {n ? `${n}. ` : ''}
                        {p.short_title}
                      </a>
                    );
                  })}
                </p>
              )}
            </div>
            {(st.tiles.length > 0 || st.chart) && (
              <div class="step-figure">
                {st.tiles.map((tile) => (
                  <Fragment set:html={tile} />
                ))}
                {st.chart && <Fragment set:html={st.chart} />}
              </div>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec" id="for-you" aria-labelledby="aud-h">
    <div class="wrap">
      <header class="sec-head">
        <h2 id="aud-h">{s.homeForYou}</h2>
        <p>{s.homeForYouIntro}</p>
      </header>
      <div class="aud-picker" role="group" aria-label={s.homeForYou} data-audience-picker hidden>
        <button type="button" data-set-audience="" aria-pressed="true">
          {s.homeAudienceAll}
        </button>
        {AUDIENCES.map((a) => (
          <button type="button" data-set-audience={a} aria-pressed="false">
            {audienceLabel(a, lang, SITE.audiences[a])}
          </button>
        ))}
      </div>
      <ul class="brief-grid" role="list" style="list-style:none;padding:0;margin:1.4rem 0 0">
        {briefs.map((p) => {
          const aud = p.id.replace(/^brief-/, '');
          return (
            <li>
              <a class="brief-card" href={href(p.id, lang)} data-aud={p.audiences.join(' ')}>
                <span class="kicker">{audienceLabel(aud, lang, SITE.audiences[aud])}</span>
                <h3 lang={contentLang}>{p.title}</h3>
                <p lang={contentLang}>{p.summary}</p>
                {p.reading_time_min && <span class="meta">{s.minRead(p.reading_time_min)}</span>}
              </a>
            </li>
          );
        })}
      </ul>
      {AUDIENCES.map((a) => (
        <div class="aud-path" data-audience-path={a} hidden>
          <h3>
            {s.homePath}: {audienceLabel(a, lang, SITE.audiences[a])}
          </h3>
          <ol>
            {paths[a].map((id) => {
              const p = PAGE_BY_ID.get(id)!;
              const n = chapterNumber(id);
              return (
                <li>
                  <a href={href(id, lang)} lang={p.lang !== lang ? p.lang : undefined}>
                    {n ? `${n}. ` : ''}
                    {p.short_title}
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="sec" id="report" aria-labelledby="rep-h">
    <div class="wrap">
      <header class="sec-head">
        <h2 id="rep-h">{s.homeReport}</h2>
        <p>{s.homeReportIntro}</p>
      </header>
      <div class="part-grid">
        {PART_LIST.map((part) => (
          <section class="part-card">
            <a href={localize(partPath(part.key), lang)}>
              <span class="kicker">{s.part(part.numeral)}</span>
              <h3>{s.parts[part.key]?.question ?? part.label}</h3>
              {partAnswers[part.numeral] && (
                <p class="part-answers" lang={contentLang}>
                  {partAnswers[part.numeral]}.
                </p>
              )}
            </a>
            <ol>
              {part.chapters.map((p) => (
                <li data-aud={p.audiences.join(' ')}>
                  <a href={href(p.id, lang)}>
                    <span class="n">{chapterNumber(p.id)}</span>
                    <span lang={contentLang}>{p.short_title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="evidence" aria-labelledby="ev-h">
    <div class="wrap">
      <header class="sec-head">
        <h2 id="ev-h">{s.legendTitle}</h2>
        <p>{s.legendIntro}</p>
      </header>
      <div class="how-we-know">
        <div>
          <div class="legend">
            <div>
              <h3>{s.legendScope}</h3>
              <dl>
                {legendScope.map((sc) => (
                  <div>
                    <dt>
                      <Fragment
                        set:html={evidenceNote(
                          {
                            label:
                              sc === 'direct'
                                ? 'VN-direct'
                                : sc === 'adjacent'
                                  ? 'VN-adjacent'
                                  : 'general',
                            confidence: 'High',
                          },
                          lang,
                          { inline: true },
                        )}
                      />
                    </dt>
                    <dd>{s.scopeLong[sc]}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <div>
              <h3>{s.legendConf}</h3>
              <dl>
                {(['high', 'medium', 'low'] as const).map((c) => (
                  <div>
                    <dt>
                      <Fragment
                        set:html={evidenceNote({ label: 'VN-direct', confidence: c }, lang, {
                          inline: true,
                        })}
                      />
                    </dt>
                    <dd>{s.confLong[c]}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <div>
              <h3>{s.legendFx}</h3>
              <dl>
                {['trend', 'projection', 'estimate', 'signal', 'wildcard', 'vision'].map((f) => (
                  <div>
                    <dt>
                      <Fragment set:html={evidenceNote({ fx: f }, lang, { inline: true })} />
                    </dt>
                    <dd>{s.fxLong[f]}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <div>
              <h3>{s.legendDx}</h3>
              <dl>
                {['stated', 'revealed', 'tested', 'inferred'].map((d) => (
                  <div>
                    <dt>
                      <Fragment set:html={evidenceNote({ dx: d }, lang, { inline: true })} />
                    </dt>
                    <dd>{s.dxLong[d]}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
          <p style="margin-top:1.5rem">
            <a href={href(ROLE.howToRead, lang, 'evidence-tags')}>{s.legendMore}</a>
          </p>
        </div>
        <div>
          {proofTiles.length > 0 && (
            <div class="kn-grid" style="margin-top:0!important">
              {proofTiles.map((tile) => (
                <Fragment set:html={tile} />
              ))}
            </div>
          )}
          <p style="margin-top:1.25rem">
            <a href={localize('/about', lang)}>{s.about}</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
