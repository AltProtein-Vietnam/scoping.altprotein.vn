---
import Base from '../layouts/Base.astro';
import PageView from '../components/PageView.astro';
import PartView from '../components/PartView.astro';
import LockedPage from '../components/LockedPage.astro';
import NotFound from '../components/NotFound.astro';
import { loadPage, mayPreview, renderPage } from '../lib/content';
import { canReadPage } from '../lib/access';
import { coverPartAnswers } from '../lib/front';
import { t } from '../lib/i18n';
import {
  DRAFT_BANNER_PAGES,
  PAGE_BY_ID,
  PART_BY_KEY,
  ROLE,
  href,
  localize,
  navKey,
  pageIdForPath,
} from '../lib/site';
import { MOVED_PAGES } from '../lib/redirects';

const lang = Astro.locals.lang ?? 'en';
const s = t(lang);
const editor = Astro.locals.editor;
const path = `/${Astro.params.path ?? ''}`;

// Links from the first edition of the site.
if (/^\/chapters(\/|$)/.test(path)) return Astro.redirect(localize('/report', lang), 301);

// Pages that moved when the report was regrouped in v0.6.
const moved = /^\/(report|appendices)\/([a-z0-9-]+)$/.exec(path);
if (moved && MOVED_PAGES[moved[2]])
  return Astro.redirect(href(MOVED_PAGES[moved[2]], lang) + Astro.url.search, 301);

// Data files that were public before v0.10 now live under /files/ (editors only).
const dataFile = /^\/data\/((?:charts\/)?[\w.-]+\.(?:csv|json|md))$/.exec(path);
if (dataFile) return Astro.redirect(`/files/data/${dataFile[1]}`, 301);

if (Astro.url.searchParams.has('_preview') && !mayPreview(Astro.locals.user))
  return new Response('Editor sign-in is required for previews.', {
    status: 403,
    headers: { 'Cache-Control': 'private, no-store' },
  });

// A part of the report, as the question it answers.
const partMatch = /^\/report\/part-(i|ii|iii|iv|v)$/.exec(path);
const part = partMatch ? PART_BY_KEY.get(partMatch[1]) : undefined;
let partAnswers: string | undefined;
if (part) {
  try {
    const cover = (await loadPage(ROLE.cover)).entry;
    partAnswers = coverPartAnswers(cover?.data.body ?? '')[part.numeral];
  } catch (error) {
    console.error(error);
  }
}

const id = part ? undefined : pageIdForPath(path);
const meta = id ? PAGE_BY_ID.get(id) : undefined;
const locked = Boolean(meta && !canReadPage(meta.id, editor));
let loaded: Awaited<ReturnType<typeof loadPage>> | null = null;
if (meta && !locked) {
  try {
    loaded = await loadPage(meta.id);
  } catch (error) {
    console.error(error);
    return new Response('The report is temporarily unavailable. Please try again.', {
      status: 503,
    });
  }
}
const entry = loaded?.entry;
const data = entry?.data;
if (!part && !locked && !entry) Astro.response.status = 404;
const rendered =
  meta && data
    ? renderPage(
        meta.id,
        data.body ?? '',
        lang,
        String(data.updatedAt ?? ''),
        Boolean(loaded?.isPreview),
        editor,
      )
    : null;
---

{part ? (
  <Base
    title={s.parts[part.key]?.question ?? part.label}
    description={partAnswers ?? part.label}
    nav={`part-${part.key}`}
    pageClass="page-part"
  >
    <PartView partKey={part.key} answers={partAnswers} />
  </Base>
) : locked && meta ? (
  <Base title={s.lockedTitle} noindex current={meta.id} pageClass="page-locked">
    <LockedPage id={meta.id} />
  </Base>
) : meta && data && rendered ? (
  <Base
    title={data.title}
    description={data.summary ?? meta.summary}
    content={{ collection: 'pages', id: entry!.id, slug: meta.id }}
    noindex={loaded?.isPreview || !canReadPage(meta.id, false)}
    current={meta.id}
    nav={navKey(meta.id)}
    banner={DRAFT_BANNER_PAGES.has(meta.id)}
    pageClass={`page-${meta.section} page-${meta.id}`}
  >
    <PageView
      meta={meta}
      title={data.title}
      summary={data.summary}
      rendered={rendered}
      isPreview={loaded?.isPreview}
    />
  </Base>
) : (
  <Base title={s.notFound} noindex>
    <NotFound />
  </Base>
)}
