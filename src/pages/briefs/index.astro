---
import Base from '../../layouts/Base.astro';
import { audienceLabel, t } from '../../lib/i18n';
import { PAGES, SITE, href } from '../../lib/site';
const lang = Astro.locals.lang ?? 'en';
const s = t(lang);
const contentLang = lang === 'vi' ? 'en' : undefined;
const briefs = PAGES.filter((p) => p.section === 'brief').sort((a, b) => a.order - b.order);
---

<Base title={s.briefs} description={s.briefsIntro} nav="briefs" pageClass="page-index">
  <div class="wrap">
    <header class="index-head">
      <p class="kicker">{s.brief}</p>
      <h1>{s.briefs}</h1>
      <p class="lede">{s.briefsIntro}</p>
    </header>
    <ul class="brief-grid" role="list" style="list-style:none;padding:0;margin:0">
      {briefs.map((p) => {
        const aud = p.id.replace(/^brief-/, '');
        return (
          <li>
            <a class="brief-card" href={href(p.id, lang)} data-aud={p.audiences.join(' ')}>
              <span class="kicker">{audienceLabel(aud, lang, SITE.audiences[aud])}</span>
              <h3 lang={contentLang}>{p.title}</h3>
              <p lang={contentLang}>{p.summary}</p>
              {p.reading_time_min && <span class="meta">{s.minRead(p.reading_time_min)}</span>}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</Base>
