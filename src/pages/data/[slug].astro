---
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import LockedPage from '../../components/LockedPage.astro';
import { t } from '../../lib/i18n';
import { DATASET_BY_SLUG } from '../../lib/datasets';
import { PAGE_BY_ID, ROLE, href, localize } from '../../lib/site';
const lang = Astro.locals.lang ?? 'en';
const s = t(lang);
const vi = lang === 'vi';
const editor = Astro.locals.editor;
const slug = Astro.params.slug ?? '';
// Data files that were public before v0.10 now live under /files/ (editors only).
if (/\.(csv|json|md)$/.test(slug)) return Astro.redirect(`/files/data/${slug}`, 301);
const d = DATASET_BY_SLUG.get(slug);
if (!d) Astro.response.status = 404;
const nf = new Intl.NumberFormat(vi ? 'vi-VN' : 'en-GB');
const sourcesHref = href(ROLE.sources, lang);
---

{!editor ? (
  <Base title={s.lockedTitle} noindex pageClass="page-locked">
    <LockedPage />
  </Base>
) : d ? (
  <Base title={d.file} description={d.purpose} noindex nav="workbench" pageClass="page-data">
    <div class="wrap">
      <header class="index-head">
        <p class="kicker">
          <a href={localize('/workbench', lang)}>{s.workbench}</a> ·{' '}
          <a href={localize('/data', lang)}>{d.group === 'chart' ? s.dataChart : s.dataHeading}</a>
        </p>
        <h1>
          <code class="file-title">{d.file}</code>
        </h1>
        {d.purpose && (
          <p class="lede" lang={vi ? 'en' : undefined}>
            {d.purpose}
          </p>
        )}
        <div class="doc-meta">
          <span>
            {nf.format(d.rows)} {s.rows} · {s.columnsCount(d.columns.length)}
          </span>
          <a class="btn" href={d.href} download>
            {s.download}
          </a>
          {d.pages.length > 0 && (
            <span>
              {s.usedIn}:{' '}
              {d.pages.map((id, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={href(id, lang)}>{PAGE_BY_ID.get(id)?.short_title}</a>
                </>
              ))}
            </span>
          )}
        </div>
      </header>
      {d.columns.some((c) => c.doc) && (
        <details class="col-docs">
          <summary>{s.columns}</summary>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">{s.column}</th>
                  <th scope="col">{s.meaning}</th>
                </tr>
              </thead>
              <tbody>
                {d.columns.map((c) => (
                  <tr>
                    <td>
                      <code>{c.name}</code>
                    </td>
                    <td lang={vi ? 'en' : undefined}>{c.doc}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      )}
      <div
        class="datatable"
        data-datatable
        data-src={d.href}
        data-sources-href={sourcesHref}
        data-docs={JSON.stringify(Object.fromEntries(d.columns.map((c) => [c.name, c.doc])))}
        data-i18n={JSON.stringify({
          more: s.loadMore,
          filter: s.filterPlaceholder,
          lang,
        })}
      >
        <div class="filters">
          <label class="field">
            {s.filter}
            <input type="search" name="filter" placeholder={s.filterPlaceholder} disabled />
          </label>
          <p class="dt-count" aria-live="polite" />
        </div>
        <noscript>
          <p class="page-note">
            {s.noJs} <a href={d.href}>{s.download}</a>
          </p>
        </noscript>
        <div class="table-wrap dt-wrap" tabindex="0" role="region" aria-label={d.file}>
          <table>
            <thead>
              <tr>
                {d.columns.map((c) => (
                  <th scope="col" title={c.doc || undefined}>
                    {c.name}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody />
          </table>
        </div>
        <p>
          <button class="btn-ghost dt-more" type="button" hidden>
            {s.loadMore}
          </button>
        </p>
      </div>
    </div>
  </Base>
) : (
  <Base title="Not found" noindex>
    <NotFound />
  </Base>
)}

<style>
  .file-title {
    font-size: 0.62em;
    background: none;
    padding: 0;
    overflow-wrap: anywhere;
  }
  .col-docs {
    margin: 0 0 0.5rem;
  }
</style>

<script>
  import { initDataTables } from '../../scripts/datatable';
  initDataTables();
</script>
