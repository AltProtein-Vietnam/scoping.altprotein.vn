---
import Base from '../../layouts/Base.astro';
import LockedPage from '../../components/LockedPage.astro';
import { t } from '../../lib/i18n';
import { DATASETS, type Dataset } from '../../lib/datasets';
import { localize } from '../../lib/site';
const lang = Astro.locals.lang ?? 'en';
const s = t(lang);
const editor = Astro.locals.editor;
const featured = DATASETS.filter((d) => d.featured);
const nf = new Intl.NumberFormat(lang === 'vi' ? 'vi-VN' : 'en-GB');
const groups: { id: string; title: string; list: Dataset[] }[] = [
  { id: 'report-data', title: s.reportData, list: DATASETS.filter((d) => d.group === 'data') },
  { id: 'charts', title: s.dataChart, list: DATASETS.filter((d) => d.group === 'chart') },
];
---

{editor ? (
  <Base
    title={s.dataHeading}
    description={s.dataIntro}
    noindex
    nav="workbench"
    pageClass="page-data"
  >
    <div class="wrap">
      <header class="index-head">
        <p class="kicker">
          <a href={localize('/workbench', lang)}>{s.workbench}</a>
        </p>
        <h1>{s.dataHeading}</h1>
        <p class="lede">{s.dataIntro}</p>
        <p class="actions">
          <a class="btn btn-primary" href="/files/downloads/altprotein-vn-data.zip" download>
            {s.downloadData}
          </a>
          <a class="btn" href="/files/downloads/altprotein-vn-working-papers.zip" download>
            {s.downloadWorking}
          </a>
          <a class="btn" href="/files/data/data-dictionary.md">
            {s.dataDictionary}
          </a>
        </p>
      </header>
      <section aria-labelledby="feat-h">
        <h2 id="feat-h" style="font-size:1.2rem">
          {s.dataFeatured}
        </h2>
        <div class="feat-grid">
          {featured.map((d) => (
            <a href={localize(`/data/${d.slug}`, lang)}>
              <code>{d.file}</code>
              <span lang="en">{d.purpose}</span>
              <span class="meta">
                {nf.format(d.rows)} {s.rows} · {s.columnsCount(d.columns.length)}
              </span>
            </a>
          ))}
        </div>
      </section>
      {groups.map((g) => (
        <section class="part-block" id={g.id} aria-labelledby={`${g.id}-h`}>
          <header>
            <h2 id={`${g.id}-h`}>{g.title}</h2>
          </header>
          <div class="table-wrap">
            <table class="data-index">
              <thead>
                <tr>
                  <th scope="col">{s.file}</th>
                  <th scope="col">{s.rows}</th>
                  <th scope="col">{s.purpose}</th>
                  <th scope="col">CSV</th>
                </tr>
              </thead>
              <tbody>
                {g.list.map((d) => (
                  <tr>
                    <td>
                      <a href={localize(`/data/${d.slug}`, lang)}>
                        <code>{d.file}</code>
                      </a>
                    </td>
                    <td>{nf.format(d.rows)}</td>
                    <td lang="en">{d.purpose}</td>
                    <td>
                      <a href={d.href} download aria-label={`${s.download}: ${d.file}`}>
                        ↓
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </div>
  </Base>
) : (
  <Base title={s.lockedTitle} noindex pageClass="page-locked">
    <LockedPage />
  </Base>
)}
