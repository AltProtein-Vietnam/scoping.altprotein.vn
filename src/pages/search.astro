---
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
import { searchPages, searchRecords } from '../lib/search';
import { PAGE_BY_ID, appendixCode, chapterNumber, href, localize } from '../lib/site';

const lang = Astro.locals.lang ?? 'en';
const s = t(lang);
const q = (Astro.url.searchParams.get('q') ?? '').slice(0, 120).trim();
const kind = Astro.url.searchParams.get('kind') ?? '';
const editor = Astro.locals.editor;
const pages = q ? await searchPages(q, 30, editor) : [];
const records = q ? searchRecords(q, 60, editor) : [];
const kinds = [...new Set(records.map((r) => r.kind))];
const shownRecords = kind && kind !== 'page' ? records.filter((r) => r.kind === kind) : records;
const showPages = !kind || kind === 'page';
const total = pages.length + records.length;
const kicker = (id: string) => {
  const p = PAGE_BY_ID.get(id)!;
  if (p.section === 'report') return s.chapter(chapterNumber(id) ?? '');
  if (p.section === 'appendix') return s.appendix(appendixCode(id) ?? '');
  if (p.section === 'brief') return s.brief;
  return s.frontMatter;
};
const link = (k: string) => {
  const u = new URLSearchParams({ q });
  if (k) u.set('kind', k);
  return `?${u}`;
};
---

<Base title={q ? `${s.search}: ${q}` : s.search} noindex={Boolean(q)} pageClass="page-search">
  <div class="wrap search-page">
    <header class="index-head">
      <h1>{s.searchHeading}</h1>
      <form role="search" method="get" action={localize('/search', lang)} class="big-search">
        <div class="search-form">
          <label class="visually-hidden" for="q-main">
            {s.search}
          </label>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <input
            id="q-main"
            name="q"
            type="search"
            value={q}
            placeholder={s.searchPlaceholder}
            autofocus={!q}
          />
        </div>
        <button class="btn btn-primary" type="submit">
          {s.search}
        </button>
      </form>
      <p class="hint" style="margin-top:.8rem">
        {editor ? s.searchHintEditor : s.searchHint}
      </p>
    </header>
    {q && (
      <p class="result-count" role="status">
        {total ? s.searchResults(total, q) : s.searchNone(q)}
      </p>
    )}
    {q && total > 0 && (
      <nav class="kind-filter" aria-label={s.filterByType}>
        <a href={link('')} aria-current={!kind ? 'true' : undefined}>
          {s.allKinds} <span>{total}</span>
        </a>
        {pages.length > 0 && (
          <a href={link('page')} aria-current={kind === 'page' ? 'true' : undefined}>
            {s.kinds.page} <span>{pages.length}</span>
          </a>
        )}
        {kinds.map((k) => (
          <a href={link(k)} aria-current={kind === k ? 'true' : undefined}>
            {s.kinds[k] ?? k} <span>{records.filter((r) => r.kind === k).length}</span>
          </a>
        ))}
      </nav>
    )}
    <ol class="results">
      {showPages &&
        pages.map((r) => {
          const p = PAGE_BY_ID.get(r.id)!;
          return (
            <li>
              <a href={href(r.id, lang)} lang={p.lang !== lang ? p.lang : undefined}>
                <span class="r-kind">{kicker(r.id)}</span>
                <span class="r-title">{p.heading}</span>
                {r.snippet ? (
                  <span class="r-text" set:html={r.snippet} />
                ) : (
                  <span class="r-text">{p.summary}</span>
                )}
              </a>
            </li>
          );
        })}
      {shownRecords.map((r) => (
        <li>
          <a href={localize(r.href, lang)}>
            <span class="r-kind">
              {s.kinds[r.kind] ?? r.kind} · {r.id}
            </span>
            <span class="r-title" lang="en">
              {r.title}
              {r.title_vi && (
                <span class="r-vi" lang="vi">
                  {' '}
                  · {r.title_vi}
                </span>
              )}
            </span>
            {r.text && (
              <span class="r-text" lang="en">
                {r.text}
              </span>
            )}
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>
