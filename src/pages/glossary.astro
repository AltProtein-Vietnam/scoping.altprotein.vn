---
import Base from '../layouts/Base.astro';
import glossaryJson from '../generated/glossary.json';
import { t } from '../lib/i18n';
import { ROLE, appendixCode, href } from '../lib/site';

type Term = Record<string, string>;
const lang = Astro.locals.lang ?? 'en';
const s = t(lang);
const vi = lang === 'vi';
const editor = Astro.locals.editor;
const terms = glossaryJson as Term[];
const categories = [...new Set(terms.map((g) => g.category))];
const fold = (x: string) => x.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd');
---

<Base title={s.glossaryHeading} description={s.glossaryIntro} pageClass="page-glossary">
  <div class="wrap">
    <header class="index-head">
      <p class="kicker">{s.footerReference}</p>
      <h1>
        {s.glossaryHeading}{' '}
        <span class="gl-sub" lang={vi ? 'en' : 'vi'}>
          {vi ? 'Glossary' : 'Thuật ngữ'}
        </span>
      </h1>
      <p class="lede">
        {s.glossaryIntro}{' '}
        <a href={href(ROLE.glossary, lang)}>{s.appendix(appendixCode(ROLE.glossary) ?? '')}</a>
        {editor && (
          <>
            {' · '}
            <a href="/files/data/glossary.csv" download>
              glossary.csv
            </a>
          </>
        )}
      </p>
    </header>
    <div class="filters gl-filters" data-gl-filters hidden>
      <label class="field">
        {s.glossaryFilter}
        <input type="search" name="gl-q" autocomplete="off" />
      </label>
      <label class="field">
        {s.category}
        <select name="gl-cat">
          <option value="">{s.allCategories}</option>
          {categories.map((c) => (
            <option value={c}>{c}</option>
          ))}
        </select>
      </label>
      <p class="gl-count" aria-live="polite" data-template={s.glossaryCount(0, 0)}></p>
    </div>
    {categories.map((cat) => (
      <section class="gl-section" data-cat={cat}>
        <h2 lang="en">{cat}</h2>
        <dl class="gl-list">
          {terms
            .filter((g) => g.category === cat)
            .map((g) => (
              <div class="gl-term" id={g.term_id} data-search={fold(Object.values(g).join(' '))}>
                <dt>
                  <span lang="en" class="gl-en">
                    {g.term_en}
                    {g.abbreviation && <abbr> ({g.abbreviation})</abbr>}
                  </span>
                  <span lang="vi" class="gl-vi">
                    {g.term_vi}
                  </span>
                </dt>
                <dd>
                  <p lang="en">{g.definition_en}</p>
                  <p lang="vi" class="gl-def-vi">
                    {g.definition_vi}
                  </p>
                </dd>
              </div>
            ))}
        </dl>
      </section>
    ))}
  </div>
</Base>

<style>
  .gl-sub {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.5em;
    letter-spacing: 0;
  }
  :global(html[lang='vi']) .gl-term dt {
    flex-direction: row-reverse;
    justify-content: flex-end;
  }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-gl-filters]');
  if (box) {
    box.hidden = false;
    const q = box.querySelector<HTMLInputElement>('input')!;
    const cat = box.querySelector<HTMLSelectElement>('select')!;
    const count = box.querySelector<HTMLElement>('.gl-count')!;
    const terms = [...document.querySelectorAll<HTMLElement>('.gl-term')];
    const sections = [...document.querySelectorAll<HTMLElement>('.gl-section')];
    const fold = (x: string) =>
      x.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd');
    const vi = document.documentElement.lang === 'vi';
    const apply = () => {
      const words = fold(q.value).split(/\s+/).filter(Boolean);
      let n = 0;
      sections.forEach((sec) => {
        const catOk = !cat.value || sec.dataset.cat === cat.value;
        let any = false;
        sec.querySelectorAll<HTMLElement>('.gl-term').forEach((el) => {
          const ok = catOk && words.every((w) => el.dataset.search!.includes(w));
          el.hidden = !ok;
          if (ok) {
            any = true;
            n++;
          }
        });
        sec.hidden = !any;
      });
      count.textContent = vi
        ? `${n} trên ${terms.length} thuật ngữ`
        : `${n} of ${terms.length} terms`;
    };
    q.addEventListener('input', apply);
    cat.addEventListener('change', apply);
    apply();
  }
</script>
