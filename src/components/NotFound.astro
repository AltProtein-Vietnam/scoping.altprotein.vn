---
import { t } from '../lib/i18n';
import { localize } from '../lib/site';
const lang = Astro.locals.lang ?? 'en';
const s = t(lang);
Astro.response.status = 404;
---

<div class="wrap">
  <div class="locked">
    <p class="kicker">404</p>
    <h1>{s.notFound}</h1>
    <p class="lede">{s.notFoundText}</p>
    <p class="actions">
      <a class="btn btn-primary" href={localize('/', lang)}>
        {s.backHome}
      </a>
      <a class="btn" href={localize('/search', lang)}>
        {s.search}
      </a>
    </p>
  </div>
</div>
