---
// A part of the report as a question: what it answers, then each chapter with its own answer.
import { t } from '../lib/i18n';
import { PART_BY_KEY, PART_LIST, chapterNumber, href, localize, partPath } from '../lib/site';
interface Props {
  partKey: string;
  /** The cover's "What it answers" text for this part (report text, in English). */
  answers?: string;
}
const { partKey, answers } = Astro.props;
const lang = Astro.locals.lang ?? 'en';
const s = t(lang);
const part = PART_BY_KEY.get(partKey)!;
const i = PART_LIST.indexOf(part);
const prev = PART_LIST[i - 1];
const next = PART_LIST[i + 1];
const contentLang = lang === 'vi' ? 'en' : undefined;
---

<div class="wrap">
  <header class="index-head">
    <p class="kicker">
      <a href={localize('/report', lang)}>{s.report}</a> · {s.part(part.numeral)} ·{' '}
      {s.chaptersCount(part.chapters.length)}
    </p>
    <h1>{s.parts[part.key]?.question ?? part.label}</h1>
    {answers && (
      <p class="lede" lang={contentLang}>
        {answers}.
      </p>
    )}
  </header>
  <ol class="chapter-list">
    {part.chapters.map((p) => (
      <li data-aud={p.audiences.join(' ')}>
        <a href={href(p.id, lang)}>
          <span class="cl-num">{chapterNumber(p.id)}</span>
          <span class="cl-title" lang={contentLang}>
            {p.heading.replace(/^\d+\.\s+/, '')}
          </span>
          {p.reading_time_min && <span class="cl-meta">{s.minutes(p.reading_time_min)}</span>}
          <span class="cl-sum" lang={contentLang}>
            {p.summary}
          </span>
        </a>
      </li>
    ))}
  </ol>
  <nav class="part-pager" aria-label={s.report}>
    <span>
      {prev && (
        <a href={localize(partPath(prev.key), lang)}>
          ← {s.part(prev.numeral)}: {s.parts[prev.key]?.question}
        </a>
      )}
    </span>
    <span>
      {next && (
        <a href={localize(partPath(next.key), lang)}>
          {s.part(next.numeral)}: {s.parts[next.key]?.question} →
        </a>
      )}
    </span>
  </nav>
</div>
