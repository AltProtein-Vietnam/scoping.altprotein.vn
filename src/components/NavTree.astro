---
// The full contents: summary pages, the five parts as questions with their chapters, the briefs,
// the reference pages and, for editors, the appendices (marked as not public).
import { audienceLabel, label, t, type Lang } from '../lib/i18n';
import { isRestrictedPage } from '../lib/access';
import {
  APPENDIX_GROUPS,
  PAGES,
  PAGE_BY_ID,
  PART_LIST,
  ROLE,
  SITE,
  appendixCode,
  chapterNumber,
  href,
  localize,
  partPath,
  type PageMeta,
} from '../lib/site';

interface Props {
  lang: Lang;
  current?: string;
  editor?: boolean;
}
const { lang, current, editor = false } = Astro.props;
const s = t(lang);
const summaryIds = [
  ROLE.twoMinute,
  ROLE.summary,
  ROLE.atAGlance,
  ROLE.prologue,
  ROLE.howToRead,
  ROLE.faq,
];
const briefAudience = (id: string) => id.replace(/^brief-/, '');
const briefs = PAGES.filter((p) => p.section === 'brief').sort((a, b) => a.order - b.order);
// Chapter and appendix titles are report text, in English.
const contentLang = lang === 'vi' ? 'en' : undefined;
const item = (p: PageMeta, n?: string) => ({
  n,
  title: p.short_title.replace(/^[A-Z]\d*\. /, ''),
  aud: p.audiences.join(' '),
  locked: isRestrictedPage(p.id),
});
---

<nav class="toc-tree" aria-label={s.contents}>
  <p class="tt-group">{s.summary}</p>
  <ul>
    {summaryIds.map((id) => {
      const p = PAGE_BY_ID.get(id)!;
      return (
        <li data-aud={p.audiences.join(' ')}>
          <a
            href={href(id, lang)}
            aria-current={id === current ? 'page' : undefined}
            lang={p.lang !== lang ? p.lang : undefined}
          >
            {p.short_title}
          </a>
        </li>
      );
    })}
  </ul>
  {PART_LIST.map((part) => (
    <>
      <p class="tt-group">{s.part(part.numeral)}</p>
      <ul>
        <li>
          <a href={localize(partPath(part.key), lang)}>
            <span class="tt-q">{s.parts[part.key]?.question ?? part.label}</span>
          </a>
        </li>
        {part.chapters.map((p) => {
          const it = item(p, String(chapterNumber(p.id)));
          return (
            <li data-aud={it.aud}>
              <a href={href(p.id, lang)} aria-current={p.id === current ? 'page' : undefined}>
                <span class="tt-n">{it.n}</span>
                <span lang={contentLang}>{it.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </>
  ))}
  <p class="tt-group">{s.briefs}</p>
  <ul>
    {briefs.map((p) => (
      <li data-aud={p.audiences.join(' ')}>
        <a href={href(p.id, lang)} aria-current={p.id === current ? 'page' : undefined}>
          {audienceLabel(briefAudience(p.id), lang, SITE.audiences[briefAudience(p.id)])}
        </a>
      </li>
    ))}
  </ul>
  <p class="tt-group">{s.footerReference}</p>
  <ul>
    <li>
      <a href={localize('/glossary', lang)}>{s.glossaryHeading}</a>
    </li>
    <li>
      <a
        href={href(ROLE.sources, lang)}
        aria-current={current === ROLE.sources ? 'page' : undefined}
      >
        {s.sourcesPage}
      </a>
    </li>
    <li>
      <a href={localize('/about', lang)}>{s.about}</a>
    </li>
  </ul>
  {editor && (
    <>
      <p class="tt-group">{s.forReviewers}</p>
      <ul>
        <li>
          <a href={localize('/workbench', lang)}>{s.workbench}</a>
        </li>
        <li>
          <a href={localize('/data', lang)}>{s.dataHeading}</a>
        </li>
      </ul>
      {APPENDIX_GROUPS.map((g) => (
        <>
          <p class="tt-group">{label(g.label, lang)}</p>
          <ul>
            {g.pages.map((id) => {
              const p = PAGE_BY_ID.get(id)!;
              const it = item(p, appendixCode(id) ?? '');
              return (
                <li>
                  <a href={href(id, lang)} aria-current={id === current ? 'page' : undefined}>
                    <span class="tt-n">{it.n}</span>
                    <span lang={contentLang}>{it.title}</span>
                    {it.locked && (
                      <span class="tt-lock" title={s.lockedLink}>
                        {s.forReviewers}
                      </span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </>
      ))}
    </>
  )}
</nav>
