---
import SourcesList from './SourcesList.astro';
import { audienceLabel, t, type Lang } from '../lib/i18n';
import { canReadPage } from '../lib/access';
import type { RenderResult } from '../lib/markdown';
import datasets from '../generated/datasets.json';
import {
  APPENDIX_GROUPS,
  PAGES,
  PAGE_BY_ID,
  READING_ORDER,
  ROLE,
  SITE,
  SUMMARY_PAGES,
  appendixCode,
  chapterNumber,
  href,
  localize,
  partOf,
  partPath,
  type PageMeta,
} from '../lib/site';

interface Props {
  meta: PageMeta;
  title: string;
  summary?: string | null;
  rendered: RenderResult;
  isPreview?: boolean;
}
const { meta, title, summary, rendered, isPreview } = Astro.props;
const lang: Lang = Astro.locals.lang ?? 'en';
const editor = Astro.locals.editor;
const s = t(lang);
const contentLang = meta.lang;
const otherLang = contentLang !== lang ? contentLang : undefined;
const uiLang = contentLang !== lang ? lang : undefined;
const chapter = chapterNumber(meta.id);
const code = appendixCode(meta.id);
const part = partOf(meta.id);

// Previous and next in reading order, skipping pages this reader cannot open.
const readable = READING_ORDER.filter((id) => canReadPage(id, editor));
const at = readable.indexOf(meta.id);
const prev = at > 0 ? PAGE_BY_ID.get(readable[at - 1]) : undefined;
const next = at >= 0 && at < readable.length - 1 ? PAGE_BY_ID.get(readable[at + 1]) : undefined;

const related = meta.related_pages
  .map((id) => PAGE_BY_ID.get(id))
  .filter((p): p is PageMeta => Boolean(p) && canReadPage(p!.id, editor));
const dataFiles = editor
  ? (meta.related_data
      .map((f) =>
        (datasets as { file: string; slug: string; group: string }[]).find(
          (d) => d.file === f && d.group === 'data',
        ),
      )
      .filter(Boolean) as { file: string; slug: string }[])
  : [];

// Rail: the part's chapters, the briefs, the summary pages or the appendix group.
const railList: { title: string; href?: string; items: PageMeta[]; num: (p: PageMeta) => string } =
  meta.section === 'report' && part
    ? {
        title: s.parts[part.key]?.question ?? part.label,
        href: localize(partPath(part.key), lang),
        items: part.chapters,
        num: (p) => String(chapterNumber(p.id)),
      }
    : meta.section === 'brief'
      ? {
          title: s.briefs,
          href: localize('/briefs', lang),
          items: PAGES.filter((p) => p.section === 'brief').sort((a, b) => a.order - b.order),
          num: () => '',
        }
      : meta.section === 'appendix'
        ? {
            title:
              APPENDIX_GROUPS.find((g) => g.pages.includes(meta.id))?.label ?? s.footerReference,
            items: (APPENDIX_GROUPS.find((g) => g.pages.includes(meta.id))?.pages ?? [])
              .map((id) => PAGE_BY_ID.get(id)!)
              .filter((p) => canReadPage(p.id, editor)),
            num: (p) => appendixCode(p.id) ?? '',
          }
        : {
            title: s.summary,
            items: [...SUMMARY_PAGES].map((id) => PAGE_BY_ID.get(id)!),
            num: () => '',
          };
const railTitle = (p: PageMeta) =>
  p.section === 'brief'
    ? audienceLabel(p.id.replace(/^brief-/, ''), lang, SITE.audiences[p.id.replace(/^brief-/, '')])
    : p.short_title.replace(/^[A-Z]\d*\. /, '');

const kicker =
  meta.section === 'report'
    ? [
        s.chapter(chapter ?? ''),
        part ? `${s.part(part.numeral)}: ${s.parts[part.key]?.question ?? part.label}` : '',
      ]
    : meta.section === 'brief'
      ? [s.brief]
      : meta.section === 'appendix'
        ? [s.appendix(code ?? '')]
        : [s.frontMatter];
const heading = (rendered.heading ?? title).replace(
  /^((?:\d+|[A-Z]\d*)\.)\s+/,
  '<span class="ch-n">$1</span> ',
);
const hasAnswer = rendered.html.includes('class="answer"');
// Report text is in English; the Vietnamese interface says so.
const langNote = lang === 'vi' && contentLang !== lang ? s.pageInEn : null;
// Registers are best used as filterable tables (the data browser is for editors).
const REGISTER_VIEWS: Record<string, { key: string; href: string; editorOnly: boolean }> = {
  [ROLE.openQuestions]: { key: 'openQuestions', href: '/data/open-questions', editorOnly: true },
  [ROLE.disagreements]: { key: 'disagreements', href: '/data/disagreements', editorOnly: true },
  [ROLE.glossary]: { key: 'glossary', href: '/glossary', editorOnly: false },
  [ROLE.sources]: { key: 'sources', href: '/data/sources', editorOnly: true },
};
const registerView = REGISTER_VIEWS[meta.id];
const showRegisterView = registerView && (editor || !registerView.editorOnly);
const toc2 = rendered.toc.filter((h) => h.depth === 2);
---

<div class="doc-page" data-section={meta.section}>
  <aside class="rail" aria-label={s.contents} lang={lang}>
    <div class="rail-part toc-tree">
      {railList.href ? (
        <a href={railList.href}>
          {part && <span class="kicker">{s.part(part.numeral)}</span>}
          <span class="rail-q">{railList.title}</span>
        </a>
      ) : (
        <p class="tt-group">{railList.title}</p>
      )}
      <ol>
        {railList.items.map((p) => (
          <li data-aud={p.audiences.join(' ')}>
            <a href={href(p.id, lang)} aria-current={p.id === meta.id ? 'page' : undefined}>
              {railList.num(p) && <span class="tt-n">{railList.num(p)}</span>}
              <span
                lang={
                  p.lang !== lang
                    ? p.lang
                    : lang === 'vi' && p.section !== 'brief'
                      ? 'en'
                      : undefined
                }
              >
                {railTitle(p)}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
    {rendered.toc.length > 1 && (
      <nav class="rail-toc" aria-labelledby="toc-title">
        <p class="kicker" id="toc-title">
          {s.onThisPage}
        </p>
        <ol lang={contentLang}>
          {rendered.toc
            .filter((h) => h.depth <= 3)
            .map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.id}`}>{h.text}</a>
              </li>
            ))}
        </ol>
      </nav>
    )}
  </aside>
  <article class="doc" lang={otherLang}>
    <header class="doc-head">
      <p class="doc-kicker" lang={uiLang}>
        {kicker.filter(Boolean).map((k, i) =>
          i === 1 && part ? (
            <a class="kicker" href={localize(partPath(part.key), lang)}>
              {k}
            </a>
          ) : (
            <span class="kicker">{k}</span>
          ),
        )}
        {meta.id === ROLE.vision && (
          <span class="evn is-inline">
            <span class="evn-body">
              <span class="evn-tag" data-fx="vision">
                {s.visionNotForecast}
              </span>
            </span>
          </span>
        )}
      </p>
      <h1 set:html={heading} />
      {(summary || meta.summary) && !hasAnswer && <p class="lede">{summary ?? meta.summary}</p>}
      <div class="doc-meta" lang={uiLang}>
        {meta.reading_time_min && <span>{s.minRead(meta.reading_time_min)}</span>}
        {meta.audiences.length > 0 && meta.audiences.length < 6 && (
          <span class="aud-chips" aria-label={s.writtenFor}>
            {meta.audiences.map((a) => (
              <span class="aud-chip" data-key={a}>
                {audienceLabel(a, lang, SITE.audiences[a])}
              </span>
            ))}
          </span>
        )}
        <a href={href(ROLE.howToRead, lang, 'evidence-tags')}>{s.howToRead}</a>
        <button class="btn-ghost no-print" type="button" data-print>
          {s.print}
        </button>
      </div>
    </header>
    {isPreview && (
      <p class="page-note is-preview" role="status" lang={lang}>
        {s.previewNote} <a href={Astro.url.pathname}>{s.exitPreview}</a>
      </p>
    )}
    {langNote && (
      <p class="page-note" lang={lang}>
        {langNote}
      </p>
    )}
    {showRegisterView && (
      <p class="page-note no-print" lang={lang}>
        <strong>{s.asTable}.</strong>{' '}
        <a href={localize(registerView.href, lang)}>{s.registerViews[registerView.key]}</a>
      </p>
    )}
    {meta.id === ROLE.method && editor && (
      <p class="page-note no-print" lang={lang}>
        <strong>{s.downloads}.</strong>{' '}
        <a href="/files/downloads/altprotein-vn-working-papers.zip" download>
          {s.downloadWorking}
        </a>{' '}
        ·{' '}
        <a href="/files/downloads/altprotein-vn-data.zip" download>
          {s.downloadData}
        </a>
      </p>
    )}
    {toc2.length > 2 && (
      <details class="mobile-toc">
        <summary lang={lang}>{s.onThisPage}</summary>
        <ol>
          {toc2.map((h) => (
            <li>
              <a href={`#${h.id}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </details>
    )}
    <div
      class={`prose${meta.id === ROLE.vision ? ' prose-vision' : ''}`}
      set:html={rendered.html}
    />
    <SourcesList ids={rendered.citations} lang={lang} />
    <footer class="doc-foot" lang={lang}>
      {related.length > 0 && (
        <section>
          <h2>{s.related}</h2>
          <ul class="related-list">
            {related.map((p) => (
              <li>
                <a href={href(p.id, lang)} lang={p.lang !== lang ? p.lang : undefined}>
                  <small>
                    {p.section === 'report'
                      ? s.chapter(chapterNumber(p.id) ?? '')
                      : p.section === 'appendix'
                        ? s.appendix(appendixCode(p.id) ?? '')
                        : p.section === 'brief'
                          ? s.brief
                          : s.frontMatter}
                  </small>
                  {p.short_title.replace(/^[A-Z]\d*\. /, '')}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {dataFiles.length > 0 && (
        <section style="margin-top:2rem">
          <h2>{s.dataHeading}</h2>
          <ul class="related-list">
            {dataFiles.map((d) => (
              <li>
                <a href={localize(`/data/${d.slug}`, lang)}>
                  <small>{s.forReviewers}</small>
                  <code>{d.file}</code>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <nav class="pager" aria-label={`${s.previous} / ${s.next}`}>
        {prev && (
          <a class="prev" href={href(prev.id, lang)} rel="prev">
            <small>← {s.previous}</small>
            <span lang={prev.lang !== lang ? prev.lang : undefined}>{prev.short_title}</span>
          </a>
        )}
        {next && (
          <a class="next" href={href(next.id, lang)} rel="next">
            <small>{s.next} →</small>
            <span lang={next.lang !== lang ? next.lang : undefined}>{next.short_title}</span>
          </a>
        )}
      </nav>
    </footer>
  </article>
</div>
