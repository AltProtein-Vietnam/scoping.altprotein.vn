---
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/be-vietnam-pro/600.css';
import '@fontsource/be-vietnam-pro/700.css';
import '@fontsource-variable/literata/wght.css';
import '@fontsource-variable/literata/wght-italic.css';
import '../styles/global.css';
import '../generated/charts.css';
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from 'emdash/ui';
import { createPublicPageContext } from 'emdash/page';
import NavTree from '../components/NavTree.astro';
import { t, type Lang } from '../lib/i18n';
import { PART_LIST, ROLE, SITE, href, localize, partPath } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** EmDash entry shown on this page (enables the editor toolbar and SEO data). */
  content?: { collection: string; id: string; slug?: string };
  noindex?: boolean;
  /** Page id, to mark it in the contents. */
  current?: string;
  /** Top navigation item to mark as current: summary, part-i to part-v, briefs. */
  nav?: string;
  pageClass?: string;
  /** Show the draft banner (the cover and the summary pages). */
  banner?: boolean;
}
const {
  title,
  description = SITE.title,
  content,
  noindex = false,
  current,
  nav,
  pageClass,
  banner = false,
} = Astro.props;
const lang: Lang = Astro.locals.lang ?? 'en';
const s = t(lang);
const vi = lang === 'vi';
const { canEdit, editor } = Astro.locals;
Astro.response.headers.set('Cache-Control', 'private, no-store');

// The same page in the other interface language.
const basePath = Astro.locals.basePath ?? Astro.url.pathname;
const enPath = basePath;
const viPath = localize(basePath, 'vi');
const otherHref = (vi ? enPath : viPath) + Astro.url.search;
const canonical = new URL(vi ? viPath : enPath, Astro.site).href;
const fullTitle =
  title === SITE.title ? `${SITE.title} · AltProtein Vietnam` : `${title} · AltProtein Vietnam`;

const page = createPublicPageContext({
  Astro,
  kind: content ? 'content' : 'custom',
  pageType: content ? 'article' : 'website',
  title: fullTitle,
  description,
  canonical,
  content,
  siteName: 'AltProtein Vietnam',
});
const draftNotice = vi ? SITE.draft_notice.vi : SITE.draft_notice.en;
const searchAction = localize('/search', lang);
const summaryHref = href(ROLE.summary, lang);
const navItems = [
  { key: 'summary', label: s.summary, href: summaryHref },
  ...PART_LIST.map((p) => ({
    key: `part-${p.key}`,
    num: p.numeral,
    label: s.parts[p.key]?.nav ?? p.label,
    href: localize(partPath(p.key), lang),
  })),
  { key: 'briefs', label: s.briefs, href: localize('/briefs', lang) },
];
const back = encodeURIComponent(Astro.url.pathname + Astro.url.search);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site).href} />
    <link rel="alternate" hreflang="vi" href={new URL(viPath, Astro.site).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AltProtein Vietnam" />
    <meta property="og:locale" content={vi ? 'vi_VN' : 'en_GB'} />
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111716" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var th = localStorage.getItem('theme');
          if (th === 'light' || th === 'dark') d.setAttribute('data-theme', th);
          var a = localStorage.getItem('audience');
          if (a) d.setAttribute('data-audience', a);
        } catch (e) {}
        d.classList.add('js');
      })();
    </script>
    <EmDashHead page={page} />
  </head>
  <body class={pageClass} data-view={editor ? 'editor' : 'public'}>
    <a class="skip-link" href="#main">
      {s.skip}
    </a>
    <EmDashBodyStart page={page} />
    {canEdit && (
      <div class="editor-bar" role="region" aria-label={editor ? s.editorView : s.publicView}>
        <div class="wrap">
          <strong>{editor ? s.editorView : s.publicView}</strong>
          <span>{editor ? s.editorViewText : s.publicViewText}</span>
          <nav aria-label={s.workbench}>
            <a href={localize('/workbench', lang)}>{s.workbench}</a>
            <a href="/_emdash/admin" rel="nofollow">
              {s.cms}
            </a>
            <a
              href={`/workbench/view?mode=${editor ? 'public' : 'editor'}&back=${back}`}
              rel="nofollow"
            >
              {editor ? s.toPublic : s.toEditor}
            </a>
          </nav>
        </div>
      </div>
    )}
    {banner && (
      <div class="draft-banner" role="note">
        <strong>{draftNotice}</strong> {s.draftNotice}
      </div>
    )}
    <header class="masthead">
      <div class="wrap mh-top">
        <a class="mh-brand" href={localize('/', lang)} aria-label={`${s.studyTitle}: ${s.home}`}>
          <img src="/logo.svg" width="183" height="45" alt="AltProtein Vietnam" />
          <span class="mh-title">
            <span>{s.studyTitle}</span>
            <small>
              {s.studySub} · {s.draft(SITE.version)}
            </small>
          </span>
        </a>
        <div class="mh-tools">
          <a class="mh-search" href={searchAction} aria-label={s.search}>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <span>{s.search}</span>
          </a>
          <a
            class="icon-btn lang-switch"
            href={otherHref}
            hreflang={vi ? 'en' : 'vi'}
            lang={vi ? 'en' : 'vi'}
            title={s.switchToLabel}
            aria-label={s.switchToLabel}
          >
            {vi ? 'EN' : 'VI'}
          </a>
          <button
            class="icon-btn theme-btn"
            type="button"
            data-theme-toggle
            aria-label={s.theme}
            data-names={JSON.stringify(s.themeNames)}
          >
            <svg
              class="i-sun"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg
              class="i-moon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
            <svg
              class="i-auto"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"></path>
            </svg>
          </button>
          <button
            class="icon-btn menu-btn"
            type="button"
            data-drawer-open
            aria-controls="drawer"
            aria-expanded="false"
            aria-label={s.menu}
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </div>
      <nav class="wrap qnav" aria-label={vi ? 'Điều hướng chính' : 'Main'}>
        {navItems.map((item) => (
          <a href={item.href} aria-current={nav === item.key ? 'page' : undefined}>
            {'num' in item && item.num && <span class="qn-num">{item.num}</span>}
            {item.label}
          </a>
        ))}
        <span class="qn-sep" aria-hidden="true"></span>
        <a href="#drawer" data-drawer-open aria-controls="drawer">
          {s.allContents}
        </a>
      </nav>
    </header>
    <div class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label={s.contents}>
      <div class="drawer-backdrop" data-drawer-close></div>
      <div class="drawer-panel">
        <div class="drawer-head">
          <img src="/logo.svg" width="146" height="36" alt="" />
          <button class="icon-btn" type="button" data-drawer-close aria-label={s.close}>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6 6 18"></path>
            </svg>
          </button>
        </div>
        <form class="search-form" role="search" action={searchAction} method="get">
          <label class="visually-hidden" for="q-drawer">
            {s.search}
          </label>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <input id="q-drawer" name="q" type="search" placeholder={s.searchPlaceholder} />
        </form>
        <NavTree lang={lang} current={current} editor={editor} />
      </div>
    </div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap foot-grid">
        <div>
          <img src="/logo.svg" width="146" height="36" alt="AltProtein Vietnam" />
          <p>{s.footerLine}</p>
        </div>
        <div>
          <h2>{s.footerReport}</h2>
          <ul>
            <li>
              <a href={href(ROLE.twoMinute, lang)}>{s.twoMinutes}</a>
            </li>
            <li>
              <a href={href(ROLE.summary, lang)}>{s.homeReadSummary}</a>
            </li>
            <li>
              <a href={localize('/report', lang)}>{s.report}</a>
            </li>
            <li>
              <a href={localize('/briefs', lang)}>{s.briefs}</a>
            </li>
          </ul>
        </div>
        <div>
          <h2>{s.footerReference}</h2>
          <ul>
            <li>
              <a href={href(ROLE.howToRead, lang)}>{s.howToRead}</a>
            </li>
            <li>
              <a href={href(ROLE.faq, lang)}>{s.faq}</a>
            </li>
            <li>
              <a href={localize('/glossary', lang)}>{s.glossaryHeading}</a>
            </li>
            <li>
              <a href={href(ROLE.sources, lang)}>{s.sourcesPage}</a>
            </li>
            <li>
              <a href={searchAction}>{s.search}</a>
            </li>
          </ul>
        </div>
        <div>
          <h2>{s.footerAbout}</h2>
          <ul>
            <li>
              <a href={localize('/about', lang)}>{s.about}</a>
            </li>
            {canEdit ? (
              <li>
                <a href={localize('/workbench', lang)}>{s.workbench}</a>
              </li>
            ) : (
              <li>
                <a href="/_emdash/admin" rel="nofollow">
                  {s.editorSignIn}
                </a>
              </li>
            )}
          </ul>
        </div>
      </div>
      <div class="wrap foot-base">
        <span class="foot-draft">
          {SITE.publisher} · <strong>{draftNotice}</strong>
        </span>
        <span>{s.notAdvice}</span>
      </div>
    </footer>
    <div class="pop" id="pop" role="dialog" hidden></div>
    <div class="tip" role="tooltip" id="tip" hidden></div>
    <EmDashBodyEnd page={page} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
