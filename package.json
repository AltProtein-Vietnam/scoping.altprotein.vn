{
  "name": "altprotein-scoping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "data:build": "node scripts/build-data.mjs",
    "dev": "node scripts/build-data.mjs && astro dev --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "preview": "wrangler dev --local",
    "typecheck": "node scripts/build-data.mjs --quiet && astro check",
    "cf:types": "wrangler types --include-runtime=false",
    "content:seed": "node scripts/build-seed.mjs",
    "content:check": "node scripts/build-seed.mjs --check && python3 report/tools/validate.py",
    "test": "node scripts/build-data.mjs --quiet && tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build:production": "CLOUDFLARE_ENV=production node scripts/build.mjs",
    "deploy:production": "pnpm build:production && wrangler deploy --env production",
    "setup:local": "node scripts/setup-local.mjs",
    "charts:check": "node scripts/charts/preview.mjs && node scripts/charts/shoot.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/react": "^6.0.5",
    "@emdash-cms/cloudflare": "^1.0.1",
    "@fontsource-variable/work-sans": "^5.3.0",
    "astro": "^7.3.2",
    "emdash": "^1.0.1",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "marked": "^16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
